# ==============================================================================
# ForensiQ - Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your environment:
#   cp .env.example .env
# ==============================================================================

# Django Secret Cryptographic Signing Key (Required)
# Generate a unique key for production (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-super-secret-django-key-min-50-characters-here

# Debug Mode (True for local development, False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
# CSRF Trusted Origins (Required for HTTPS tunnels and reverse proxies, e.g. https://*.trycloudflare.com)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Master Portal Security Key (Required)
# Password required to unlock the investigative workstation portal
PORTAL_ACCESS_PASSWORD=your-secure-portal-access-password-here

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# ==============================================================================
# Database Configuration
# Dev: DB_ENGINE=sqlite3 (default)
# Prod: DB_ENGINE=mssql (requires mssql-django)
# ==============================================================================
DB_ENGINE=sqlite3

# MSSQL Production Settings (Used when DB_ENGINE=mssql)
# DB_NAME=ForensiQ_Audit
# DB_USER=sa
# DB_PASSWORD=your-secure-sql-password
# DB_HOST=localhost
# DB_PORT=1433
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_EXTRA_PARAMS=TrustServerCertificate=yes

# ==============================================================================
# Model-Host Service Endpoints (Local Model-Host: D:\Vikash\Hyundai\Code\Model-Host)
# ==============================================================================
# Q-Voice Forensic Speech-to-Text / Whisper Model Endpoint
VOICE_MODEL_ENDPOINT=http://127.0.0.1:8434/v1/audio/transcriptions
VOICE_API_TIMEOUT=60.0

# Q-Link Forensic LLM / Llama Model Endpoint
LLM_API_ENDPOINT=http://127.0.0.1:8434/v1/chat/completions
LLM_MODEL_NAME=./models/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLM_API_KEY=model-host
LLM_API_TIMEOUT=30.0

